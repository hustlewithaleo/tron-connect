{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path]"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/platform",
      "destination": "/index.html"
    },
    {
      "source": "/dash",
      "destination": "/index.html"
    },
    {
      "source": "/t/(.*)",
      "destination": "/index.html"
    }
  ]
}
