{
  "name": "tron-connect",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "tsx server/index.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@reown/appkit": "^1.8.24",
    "@reown/appkit-adapter-ethers": "1.8.24",
"ethers": "^6.13.4",
    "@reown/appkit-adapter-tron": "^1.8.24",
    "@reown/appkit-utils": "^1.8.24",
    "@tronweb3/tronwallet-adapter-trust": "^1.0.2",
    "@upstash/redis": "^1.41.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tronweb": "^6.5.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.3.5"
  }
}
