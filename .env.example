# Reown / WalletConnect Project ID (exposed to the browser).
VITE_WC_PROJECT_ID=your_project_id_here

# Optional: canonical public URL when a custom domain is used, e.g.
# https://app.example.com. Leave empty to use the deployment origin.
# It must exactly match the origin users open and the Reown allowlist.
# VITE_APP_URL=

# Tron address (base58, starts with T) that receives the USDT allowance.
# Used server-side to read allowance() and client-side to build approve().
SPENDER=

# Private key of SPENDER (64 hex chars). Required only for the admin "Deduct"
# widget, which signs USDT transferFrom. Leave empty to disable deductions.
# NEVER commit this value.
SPENDER_PRIVATE_KEY=

# Optional: free TronGrid API key from https://www.trongrid.io
TRONGRID_API_KEY=

# Required for the admin panel and /api/admin/*.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# API server port (Vite dev proxies /api to http://localhost:5181).
PORT=5181

# Optional: minimum acceptable allowance in raw token units (6 decimals).
# Defaults to 2^256-1 (unlimited). Example: 1000000000 = 1,000 USDT.
# MIN_ALLOWANCE=

# Optional overrides.
# USDT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# TRON_FULL_HOST=https://api.trongrid.io
# DATA_FILE=data/store.json
# MAX_RECORDS=2000

# Optional: extra origins the admin may set as the dApp URL in Branding.
# The origin the admin is currently opened on is always allowed.
# ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com

# Vercel: provision Upstash Redis from the Marketplace and these are set
# automatically. Without them the API falls back to in-memory storage
# (admin data is lost between cold starts).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
